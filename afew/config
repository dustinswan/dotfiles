[SpamFilter]
#[ClassifyingFilter]
[KillThreadsFilter]
[ListMailsFilter]
[ArchiveSentMailsFilter]
[InboxFilter]

[MailMover]
folders = iocom/INBOX/ iocom/INBOX.Archive/ gmail/INBOX/
max_age = 15

iocom/INBOX/ = 'NOT tag:inbox':iocom/INBOX.Archive/
iocom/INBOX.Archive/ = 'tag:inbox':iocom/INBOX/

gmail/INBOX/ = 'NOT tag:inbox':gmail/archive/
