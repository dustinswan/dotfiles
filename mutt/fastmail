set from      = "dustin@dustinswan.com"
set sendmail  = "/usr/bin/msmtp -a FastMali"
set mbox      = "+FastMail/INBOX.Archive"
set postponed = "+FastMail/INBOX.Drafts"

color status blue default

macro index D \
    "<save-message>+FastMail/INBOX.Trash<enter>" \
    "move message to the trash"

macro index S \
    "<save-message>+FastMail/INBOX.Spam<enter>"  \
        "mark message as spam"
