{ config, lib, pkgs, machine, ... }:

let
  work =
    if machine.isWork
    then import ./secrets-majorrocket.nix
    else { mr = { user = ""; hostname = ""; }; mrFleet = [ ]; };

  mrKey = {
    IdentityFile = "${config.home.homeDirectory}/.ssh/id_rsa_mr";
    IdentitiesOnly = true;
  };

  # Prod fleet aliases are derived from mrFleet
  fleetHosts = builtins.listToAttrs (map (h: {
    name = h.alias;
    value = mrKey // { User = h.user; HostName = h.hostname; };
  }) work.mrFleet);
in
lib.mkIf machine.isWork {
  home.packages = with pkgs; [ ddev mkcert ngrok firebase-tools ];

  programs.ssh.settings = {
    "bitbucket.org" = {
      IdentityFile = "${config.home.homeDirectory}/.ssh/id_ed25519";
      IdentitiesOnly = true;
      UseKeychain = "yes";
      AddKeysToAgent = "yes";
    };

    # id_ed25519 is on the dustinmr GitHub account; personal repos use this alias
    "github-personal" = {
      HostName = "github.com";
      User = "git";
      IdentityFile = "${config.home.homeDirectory}/.ssh/id_ed25519_personal";
      IdentitiesOnly = true;
      UseKeychain = "yes";
      AddKeysToAgent = "yes";
    };

    mr = mrKey // { User = work.mr.user; HostName = work.mr.hostname; };
  } // fleetHosts;

  home.file.".config/mr/fleet.json".text = builtins.toJSON {
    _comment = "GENERATED by home-manager. Do not edit.";
    hosts = map (h: {
      inherit (h) alias user hostname inRotation roles;
      autolaunch = h.autolaunch or false;
    }) work.mrFleet;
  };
}
